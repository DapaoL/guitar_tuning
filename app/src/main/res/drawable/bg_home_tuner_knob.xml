<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#4D7FE7FF" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:endColor="#F6FBFF"
                        android:startColor="#7FE7FF" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/home_tint_blue" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#E9F1FB"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#A6BDD7" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#D7E4F0"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#93A9C2" />
        </shape>
    </item>
</selector>
