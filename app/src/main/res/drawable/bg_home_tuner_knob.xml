<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#55F2B84B" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:endColor="#FFF7E6"
                        android:startColor="#F2C15B" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/home_tint_gold" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#D7C7A7"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#8A7A63" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#C7B89A"
                android:startColor="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#8A7A63" />
        </shape>
    </item>
</selector>
