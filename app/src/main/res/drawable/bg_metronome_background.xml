<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/home_bg_bottom"
                android:startColor="@color/home_bg_top" />
        </shape>
    </item>

    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#44F2B84B" />
        </shape>
    </item>
</layer-list>
