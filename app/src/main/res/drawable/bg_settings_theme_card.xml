<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_theme_card_selected" />
            <stroke
                android:width="2dp"
                android:color="@color/settings_accent_gold" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_theme_card_unselected" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
