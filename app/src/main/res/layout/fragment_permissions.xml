<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="page"
            type="com.dp.guitartuning.ui.fragments.settings.PermissionsFragment" />
    </data>

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings_screen"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:orientation="vertical"
            android:paddingBottom="110dp">

            <!-- RECORD_AUDIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_settings_secondary_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/permissionRecordAudioTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_settings_permission_record_audio_title"
                    android:textColor="@color/settings_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_settings_permission_record_audio_summary"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- VIBRATE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_settings_secondary_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/permissionVibrateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_settings_permission_vibrate_title"
                    android:textColor="@color/settings_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_settings_permission_vibrate_summary"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- INTERNET -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_settings_secondary_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/permissionNetworkTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_settings_permission_network_title"
                    android:textColor="@color/settings_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_settings_permission_network_summary"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ACCESS_NETWORK_STATE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_settings_secondary_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/permissionNetworkStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_settings_permission_network_state_title"
                    android:textColor="@color/settings_accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_settings_permission_network_state_summary"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 椤堕儴娴姩鏍囬鏍?-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_settings_screen">

        <TextView
            android:id="@+id/permissionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_settings_permissions_title"
            android:textColor="@color/settings_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_settings_permissions_subtitle"
            android:textColor="@color/settings_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/permissionsTitle"
            app:layout_constraintStart_toStartOf="@+id/permissionsTitle"
            app:layout_constraintTop_toBottomOf="@+id/permissionsTitle" />

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_back_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_back"
            android:textColor="@color/settings_text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/permissionsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/permissionsTitle"
                android:onClick="@{page::goBack}" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
</layout>
