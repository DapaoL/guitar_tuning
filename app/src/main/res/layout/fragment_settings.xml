<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="page"
            type="com.dp.guitartuning.ui.fragments.settings.SettingsFragment" />
    </data>

<FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings_screen"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layout_marginTop="50dp"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_settings_badge"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/settings_home_badge"
                    android:textColor="@color/settings_accent_gold"
                    android:textSize="12sp"
                    android:visibility="gone" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_settings_primary_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reference_a4_title"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_reference_a4_summary"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/referenceA4InputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/settings_reference_a4_hint"
                        app:boxBackgroundColor="@color/settings_input_fill"
                        app:boxBackgroundMode="filled"
                        app:boxStrokeColor="@color/settings_accent_gold"
                        app:boxStrokeErrorColor="@color/settings_error"
                        app:hintTextColor="@color/settings_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReferenceA4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:textColor="@color/settings_text_primary"
                            android:textColorHint="@color/settings_text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnApplyA4"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_settings_action_button"
                        android:text="@string/settings_reference_a4_apply"
                        android:textAllCaps="false"
                        android:textColor="@color/settings_bg_top"
                        android:textStyle="bold"
                android:onClick="@{page::applyReferenceA4}" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_settings_secondary_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sensitivity_title"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/groupSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/optionSensitivityHigh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/settings_accent_gold"
                            android:text="@string/settings_sensitivity_high"
                            android:textColor="@color/settings_text_primary"
                android:onClick="@{page::selectHighSensitivity}" />

                        <RadioButton
                            android:id="@+id/optionSensitivityMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/settings_accent_gold"
                            android:text="@string/settings_sensitivity_medium"
                            android:textColor="@color/settings_text_primary"
                android:onClick="@{page::selectMediumSensitivity}" />

                        <RadioButton
                            android:id="@+id/optionSensitivityLow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/settings_accent_gold"
                            android:text="@string/settings_sensitivity_low"
                            android:textColor="@color/settings_text_primary"
                android:onClick="@{page::selectLowSensitivity}" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_settings_secondary_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_display_mode_title"
                        android:textColor="@color/settings_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/groupDisplayMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/optionDisplayGauge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/settings_accent_gold"
                            android:text="@string/settings_display_mode_gauge"
                            android:textColor="@color/settings_text_primary"
                android:onClick="@{page::selectGaugeDisplay}" />

                        <RadioButton
                            android:id="@+id/optionDisplayPointer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/settings_accent_gold"
                            android:text="@string/settings_display_mode_pointer"
                            android:textColor="@color/settings_text_primary"
                android:onClick="@{page::selectPointerDisplay}" />

                        <RadioButton
                            android:id="@+id/optionDisplayNumeric"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/settings_accent_gold"
                            android:text="@string/settings_display_mode_numeric"
                            android:textColor="@color/settings_text_primary"
                android:onClick="@{page::selectNumericDisplay}" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_settings_screen">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/settings_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_home_tuner_summary"
                android:textColor="@color/settings_text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@+id/textView"
                app:layout_constraintStart_toStartOf="@+id/textView"
                app:layout_constraintTop_toBottomOf="@+id/textView" />


            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_back_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_back"
                android:textColor="@color/settings_text_secondary"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textView"
                android:onClick="@{page::goBack}" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </FrameLayout>
</layout>
