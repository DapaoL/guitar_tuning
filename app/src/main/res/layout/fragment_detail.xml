<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="page"
            type="com.dp.guitartuning.ui.fragments.detail.DetailFragment" />

        <variable
            name="vm"
            type="com.dp.guitartuning.ui.fragments.detail.DetailViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_metronome_background">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_metronome_header"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_metronome_chip"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/metronome_badge"
                        android:textColor="@color/home_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:text="@string/tab_metronome"
                        android:textColor="@color/white"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tv_poppins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_medium"
                        android:gravity="center"
                        android:onClick="@{page::selectTimeSignature}"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/metronome_time_signature_four_four"
                        android:textColor="@color/home_text_muted"
                        android:textSize="14sp" />


                    <FrameLayout
                        android:layout_width="228dp"
                        android:layout_height="228dp"
                        android:layout_marginTop="24dp">

                        <FrameLayout
                            android:id="@+id/metronome_ring_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_metronome_ring" />

                        <FrameLayout
                            android:id="@+id/metronome_ring_marker_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_metronome_ring_marker" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="18dp"
                            android:background="@drawable/bg_metronome_ring_inner"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/current_bpm_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_black"
                                android:includeFontPadding="false"
                                android:text="120"
                                android:textColor="@color/white"
                                android:textSize="64sp" />

                            <ImageButton
                                android:id="@+id/play_pause_button"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_metronome_button_primary"
                                android:contentDescription="@string/metronome_play"
                                android:onClick="@{page::togglePlayback}"
                                android:padding="10dp"
                                android:scaleType="center"
                                android:src="@drawable/ic_metronome_play" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/beat_visualizer"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_metronome_panel"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/metronome_speed_settings_title"
                        android:textColor="@color/home_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/metronome_speed_settings_summary"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/bpm_input"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:background="@drawable/bg_metronome_input"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:hint="120"
                            android:inputType="number"
                            android:maxLength="3"
                            android:text="120"
                            android:textColor="@color/home_text_primary"
                            android:textColorHint="@color/home_text_secondary"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="BPM"
                            android:textColor="@color/home_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_metronome_button_primary"
                        android:fontFamily="@font/poppins_medium"
                        android:onClick="@{page::start}"
                        android:stateListAnimator="@null"
                        android:text="@string/metronome_start"
                        android:textAllCaps="false"
                        android:textColor="@color/home_text_primary"
                        android:textSize="16sp" />

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_metronome_button_secondary"
                        android:fontFamily="@font/poppins_medium"
                        android:onClick="@{page::stop}"
                        android:stateListAnimator="@null"
                        android:text="@string/metronome_stop"
                        android:textAllCaps="false"
                        android:textColor="@color/home_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</layout>
